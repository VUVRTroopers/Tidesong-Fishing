rules_version = '2';
// Tidesong's cloud saves: one document per player, saves/{uid}, that only that player can read or write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'save', 'at', 'dev', 'bonus', 'sum'])
        && request.resource.data.save is string
        && request.resource.data.save.size() < 900000
        && request.resource.data.at is number;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
